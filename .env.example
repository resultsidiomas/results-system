# OpenAI (agentes)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_COMMERCIAL=gpt-4.1-mini
OPENAI_MODEL_SUPPORT=gpt-4.1-mini
OPENAI_MODEL_ROUTER=gpt-4.1-mini
OPENAI_MAX_TOKENS=25000
# Temperatura dos agentes M1/M2. Antes nao era definida (default 1.0 da OpenAI)
# e a adesao a regra rigida ficava instavel. Classificadores usam 0 fixo.
AGENT_TEMPERATURE=0.4
# Tentativas por turno (1 = sem retry). Falha transitoria da OpenAI ou JSON
# truncado nao deve virar resposta de fallback na primeira tentativa.
AGENT_COMPLETION_ATTEMPTS=2
# Emoji por resposta (nao por bolha). Excedente e removido pela integracao.
AGENT_MAX_EMOJIS=1
# Teto de bolhas por resposta - o resto e fundido na ultima.
AGENT_MAX_BUBBLES=5
# Duracao da pausa apos handoff = 1 dia (decisao do usuario, 2026-07-25).
# Prazo absoluto contado do momento da pausa; depois disso a IA reassume.
# Nao existe rotina de resume: sem isso, pausar_ia='Sim' e permanente.
AGENT_PAUSE_MAX_HOURS=24
# Aceitar a aula experimental pausa a IA e entrega pra uma pessoa (ADR-015).
# `false` = comportamento anterior: a Gi é avisada mas a IA continua conversando.
# Ligar só com alguém acompanhando os handoffs — se o modelo marcar
# `wants_to_schedule` por sinal implícito, a IA emudece e o lead fica esperando.
AGENT_PAUSE_ON_SCHEDULE_ACCEPT=false

# Supabase (identificacao, realtime, historico)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# Redis (juncao de msgs + pausa humana + memoria de contexto)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=...
AGENT_MESSAGE_WAIT_MS=18000
AGENT_BLOCK_TTL_SECONDS=3600
AGENT_HISTORY_LIMIT=15

# UAZAPI (conversas WhatsApp)
UAZAPI_URL=https://sua-instancia.uazapi.com
UAZAPI_TOKEN=...
UAZAPI_INSTANCE=results-principal
UAZAPI_SEND_DELAY_MS=1500
UAZAPI_WEBHOOK_SECRET=...

# WhatsApp Business API Oficial (disparos em massa, M5 - ainda nao usado no codigo)
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=

# Groq (transcricao de audio - opcional; sem isso, mensagens de audio falham)
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Handoff M1 -> Gi (opcional; sem isso o handoff so pausa a IA, sem alerta)
GI_ALERT_NUMBER=

# Base de conhecimento / RAG (ADR-009)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_MATCH_COUNT=4
# Piso de similaridade (0-1): chunk abaixo disso e descartado em vez de entrar
# como contexto irrelevante. Sem piso, o RPC devolvia sempre 4 chunks.
KNOWLEDGE_MIN_SIMILARITY=0.3

# Console de teste do agente (frontend interno, nao expor publicamente)
TEST_CONSOLE_TOKEN=change-me

# Console de teste do painel -> fluxo n8n REAL.
# Webhook do fluxo de atendimento aceitando `testMode: true`: o fluxo roda
# inteiro (filtros, debounce, fracionamento, chamada ao backend) e desvia do
# node de envio da UAZAPI, devolvendo a resposta pelo "Respond to Webhook".
# Ver docs/CONSOLE-TESTE-N8N.md para o contrato exato.
# Se ficar VAZIA, o console roda a engine direto no backend (sem a camada n8n)
# e o painel avisa qual caminho respondeu.
N8N_TEST_WEBHOOK_URL=
N8N_TEST_SECRET=
N8N_TEST_TIMEOUT_MS=90000

# n8n - acesso para diagnostico (NAO consumido pelo backend, so por scripts/curl
# manual quando for preciso inspecionar workflow ou execucoes com erro).
# API key: n8n > Settings > n8n API > Create an API key.
N8N_BASE_URL=
N8N_API_KEY=

# Endpoint /api/v1/n8n-agent/run - token que o n8n envia no header x-internal-key
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Allowlist temporaria de teste (M1 em validacao) - wa_chatid separados por
# virgula; vazio = responde a todos (producao)
TEST_ALLOWED_NUMBERS=

# App
NODE_ENV=development
PORT=3000
SCHEDULE_RESUME_HOUR=8
