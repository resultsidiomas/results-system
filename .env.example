# OpenAI (agentes)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_COMMERCIAL=gpt-4.1-mini
OPENAI_MODEL_SUPPORT=gpt-4.1-mini
OPENAI_MODEL_ROUTER=gpt-4.1-mini
OPENAI_MAX_TOKENS=1024

# Supabase (identificacao, realtime, historico)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# PostgreSQL direto (memoria persistente dos agentes)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Redis (juncao de msgs + pausa humana + memoria de contexto)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=...
AGENT_MESSAGE_WAIT_MS=45000
AGENT_BLOCK_TTL_SECONDS=3600
AGENT_HISTORY_LIMIT=15

# UAZAPI (conversas WhatsApp)
UAZAPI_URL=https://sua-instancia.uazapi.com
UAZAPI_TOKEN=...
UAZAPI_INSTANCE=results-principal
UAZAPI_SEND_DELAY_MS=1500
UAZAPI_WEBHOOK_SECRET=...

# WhatsApp Business API Oficial (disparos em massa)
WA_API_TOKEN=...
WA_PHONE_NUMBER_ID=...
WA_BUSINESS_ACCOUNT_ID=...

# Groq (transcricao de audio)
GROQ_API_KEY=...
GROQ_MODEL=whisper-large-v3-turbo

# Handoff M1 -> Gi (opcional; sem isso o handoff so pausa a IA, sem alerta)
GI_ALERT_NUMBER=

# Base de conhecimento / RAG (ADR-009)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_MATCH_COUNT=4

# Console de teste do agente (frontend interno, nao expor publicamente)
TEST_CONSOLE_TOKEN=change-me

# App
NODE_ENV=development
PORT=3000
SCHEDULE_RESUME_HOUR=8
