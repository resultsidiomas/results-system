# OpenAI (agentes)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_COMMERCIAL=gpt-4.1-mini
OPENAI_MODEL_SUPPORT=gpt-4.1-mini
OPENAI_MODEL_ROUTER=gpt-4.1-mini
OPENAI_MAX_TOKENS=1024
# Temperatura dos agentes M1/M2. Antes nao era definida (default 1.0 da OpenAI)
# e a adesao a regra rigida ficava instavel. Classificadores usam 0 fixo.
AGENT_TEMPERATURE=0.4

# Supabase (identificacao, realtime, historico)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# Redis (juncao de msgs + pausa humana + memoria de contexto)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=...
AGENT_MESSAGE_WAIT_MS=18000
AGENT_BLOCK_TTL_SECONDS=3600
AGENT_HISTORY_LIMIT=15

# UAZAPI (conversas WhatsApp)
UAZAPI_URL=https://sua-instancia.uazapi.com
UAZAPI_TOKEN=...
UAZAPI_INSTANCE=results-principal
UAZAPI_SEND_DELAY_MS=1500
UAZAPI_WEBHOOK_SECRET=...

# WhatsApp Business API Oficial (disparos em massa, M5 - ainda nao usado no codigo)
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=

# Groq (transcricao de audio - opcional; sem isso, mensagens de audio falham)
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Handoff M1 -> Gi (opcional; sem isso o handoff so pausa a IA, sem alerta)
GI_ALERT_NUMBER=

# Base de conhecimento / RAG (ADR-009)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_MATCH_COUNT=4
# Piso de similaridade (0-1): chunk abaixo disso e descartado em vez de entrar
# como contexto irrelevante. Sem piso, o RPC devolvia sempre 4 chunks.
KNOWLEDGE_MIN_SIMILARITY=0.3

# Console de teste do agente (frontend interno, nao expor publicamente)
TEST_CONSOLE_TOKEN=change-me

# n8n - acesso para diagnostico (NAO consumido pelo backend, so por scripts/curl
# manual quando for preciso inspecionar workflow ou execucoes com erro).
# API key: n8n > Settings > n8n API > Create an API key.
N8N_BASE_URL=
N8N_API_KEY=

# Endpoint /api/v1/n8n-agent/run - token que o n8n envia no header x-internal-key
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Allowlist temporaria de teste (M1 em validacao) - wa_chatid separados por
# virgula; vazio = responde a todos (producao)
TEST_ALLOWED_NUMBERS=

# App
NODE_ENV=development
PORT=3000
SCHEDULE_RESUME_HOUR=8
