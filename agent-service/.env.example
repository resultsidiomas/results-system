# OpenAI (mesma chave ja usada pelo backend principal — ver ADR-008)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=1024

# Seguranca - header x-internal-key deve bater com este valor
INTERNAL_API_KEY=change-me-to-a-long-random-string

# App
PORT=3000
NODE_ENV=production

# Memoria de conversa (Map em memoria, nao persistente)
SESSION_HISTORY_LIMIT=20
SESSION_TTL_MS=3600000
