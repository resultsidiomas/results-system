{
  "name": "results-idiomas-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../.env watch server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ingest:knowledge": "tsx --env-file=../.env scripts/ingest-knowledge.ts"
  },
  "dependencies": {
    "fastify": "^4",
    "openai": "^4",
    "@supabase/supabase-js": "^2",
    "ioredis": "^5",
    "zod": "^3",
    "fastify-plugin": "^4",
    "@fastify/cors": "^9"
  },
  "devDependencies": {
    "typescript": "^5",
    "tsx": "^4",
    "@types/node": "^20"
  }
}
