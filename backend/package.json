{
  "name": "results-idiomas-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file=../.env watch server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ingest:knowledge": "tsx --env-file=../.env scripts/ingest-knowledge.ts",
    "test:unit": "tsx --env-file=../.env tests/unit/text-sanitizer.smoke.ts && tsx --env-file=../.env tests/unit/agent.fracture.smoke.ts && tsx --env-file=../.env tests/unit/agent.completion.smoke.ts && tsx --env-file=../.env tests/unit/commercial.scoring.smoke.ts && tsx --env-file=../.env tests/unit/knowledge.chunker.smoke.ts && tsx --env-file=../.env tests/unit/support.schema.smoke.ts",
    "eval:commercial": "tsx --env-file=../.env tests/e2e/commercial.eval.ts",
    "eval:support": "tsx --env-file=../.env tests/e2e/support.eval.ts",
    "reset:memory": "tsx --env-file=../.env scripts/reset-memory.ts",
    "simulate:commercial": "tsx --env-file=../.env scripts/simulate-conversation.ts"
  },
  "dependencies": {
    "fastify": "^4",
    "openai": "^4",
    "@supabase/supabase-js": "^2",
    "ioredis": "^5",
    "zod": "^3",
    "fastify-plugin": "^4",
    "@fastify/cors": "^9"
  },
  "devDependencies": {
    "typescript": "^5",
    "tsx": "^4",
    "@types/node": "^22"
  }
}
