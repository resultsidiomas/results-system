# Supabase — mesmas credenciais do projeto usado pelo backend.
# A chave ANÔNIMA é a correta aqui: ela é pública por design e respeita RLS.
# Nunca colocar a SERVICE_ROLE_KEY no frontend — ela ignora RLS e ficaria
# exposta no bundle que vai para o navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend Fastify (sem barra no fim). Ex.: http://localhost:3000
VITE_API_URL=http://localhost:3000
